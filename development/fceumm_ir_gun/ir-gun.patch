+/* Frontend port 0 supplies both physical NES devices. */
+static void apply_ir_hybrid(void)
+{
+   update_nes_controllers(0, RETRO_DEVICE_GAMEPAD);
+   update_nes_controllers(1, RETRO_DEVICE_ZAPPER);
+   nes_input.type[2] = nes_input.type[3] = RETRO_DEVICE_NONE;
+   update_nes_controllers(4, RETRO_DEVICE_NONE);
+   FCEUI_DisableFourScore(1);
+   switchZapper = 0;
+}
+
+void retro_set_controller_port_device(unsigned port, unsigned device)
+{
+   bool restore;
+   if (port >= 5) return;
+   restore = port == 0 && ir_devices[0] == RETRO_DEVICE_IR_ZAPPER && device != RETRO_DEVICE_IR_ZAPPER;
+   ir_devices[port] = device;
+   if (!GameInfo) return; /* Connect after retro_load_game creates the game. */
+   if (device != RETRO_DEVICE_IR_ZAPPER)
+      set_native_controller(port, device);
+   if (ir_devices[0] == RETRO_DEVICE_IR_ZAPPER)
+      apply_ir_hybrid();
+   else if (restore)
+   {
+      unsigned i;
+      for (i = 1; i < 5; ++i) set_native_controller(i, ir_devices[i]);
+   }
+}
