+static void update_ir_zapper(void)
+{
+   uint32_t *data = nes_input.MouseData[1];
+   int x = input_cb(0, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_X);
+   int y = input_cb(0, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_Y);
+   int w = NES_WIDTH - crop_overscan_h_left - crop_overscan_h_right;
+   int h = NES_HEIGHT - crop_overscan_v_top - crop_overscan_v_bottom;
+   bool away = input_cb(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A) != 0;
+   data[0] = crop_overscan_h_left + ((x + 32768) * (w - 1)) / 65535;
+   data[1] = crop_overscan_v_top + ((y + 32768) * (h - 1)) / 65535;
+   data[2] = input_cb(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B) ? 1 : 0;
+   data[3] = 0;
+   if (away)
+   {
+      data[0] = NES_WIDTH;
+      data[1] = NES_HEIGHT;
+      data[2] |= 2; /* Native Zapper away-trigger bit: trigger with no light. */
+   }
+}
