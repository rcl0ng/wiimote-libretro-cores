index 0000000..d364911
--- /dev/null
+++ b/shell/libretro/hybrid_lightgun.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Absolute Lichtknarre/vJoy input policy. No deadzone, velocity or integration.
+#pragma once
+#include <algorithm>
+#include <string_view>
+
+namespace hybrid {
+enum class ReloadMode { Offscreen, MappedButton };
+
+inline int coordinate(int axis, int maximum)
+{
+	axis = std::clamp(axis, -32768, 32767);
+	return (axis + 32768) * maximum / 65535;
+}
+
+inline ReloadMode reloadMode(bool arcade, bool atomiswave,
+		std::string_view family, std::string_view gameId)
+{
+	if (!arcade)
+		return ReloadMode::Offscreen;
+	if (atomiswave)
+		return ReloadMode::MappedButton; // Flycast's AW lightgun mapping: BTN0=PUMP.
+	// Match identified cartridge parent/name, not the user's archive basename.
+	// These match standalone's mapped B input (NAOMI_BTN1).
+	if (family == "hotd2" || family == "confmiss" || family == "mok"
+			|| gameId.substr(0, 5) == "hotd2"
+			|| gameId == " CONFIDENTIAL MISSION ---------"
+			|| gameId == "THE MAZE OF THE KINGS")
+		return ReloadMode::MappedButton;
+	// Ninja Assault, Death Crimson OX, Lupin and unknown Naomi profiles:
+	// use the existing per-cabinet NAOMI_RELOAD_KEY implementation.
+	return ReloadMode::Offscreen;
+}
+}
