+static void UpdateHybridLightgun(u32 port)
+{
+	const bool arcade = settings.platform.isArcade();
+	const bool aw = settings.platform.isAtomiswave();
+	const Game *game = CurrentCartridge != nullptr ? CurrentCartridge->game : nullptr;
+	const char *family = game != nullptr ? (game->parent_name != nullptr ? game->parent_name : game->name) : "";
+	const auto mode = hybrid::reloadMode(arcade, aw, family, settings.content.gameId);
+	unsigned bits = static_cast<uint16_t>(getBitmask(port, RETRO_DEVICE_HYBRID_LIGHTGUN));
+	int x = input_cb(port, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_X);
+	int y = input_cb(port, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT, RETRO_DEVICE_ID_ANALOG_Y);
+	// Match standalone GamepadDevice's absolute mapping, before its radial deadzone.
+	mo_x_abs[port] = hybrid::coordinate(x, 639);
+	mo_y_abs[port] = hybrid::coordinate(y, 479);
+	lightgun_params[port].x = mo_x_abs[port];
+	lightgun_params[port].y = mo_y_abs[port];
+	lightgun_params[port].offscreen = false;
+	kcode[port] = ~0U; // Clear every previous button, including synthetic reload.
+	joyx[port] = joyy[port] = joyrx[port] = joyry[port] = lt[port] = rt[port] = 0;
+	const bool reloadAuto = bits & (1U << RETRO_DEVICE_ID_JOYPAD_A);
+	const bool offscreen = (bits & (1U << RETRO_DEVICE_ID_JOYPAD_X))
+			|| (reloadAuto && mode == hybrid::ReloadMode::Offscreen);
+	const bool mapped = (bits & (1U << RETRO_DEVICE_ID_JOYPAD_Y))
+			|| (reloadAuto && mode == hybrid::ReloadMode::MappedButton);
+	const uint32_t trigger = !arcade ? DC_BTN_A : aw ? AWAVE_TRIGGER_KEY : NAOMI_BTN0_KEY;
+	const uint32_t reloadKey = !arcade ? DC_BTN_RELOAD : aw ? AWAVE_BTN0_KEY : NAOMI_RELOAD_KEY;
+	const uint32_t buttonKey = !arcade ? DC_BTN_B : aw ? AWAVE_BTN0_KEY : NAOMI_BTN1_KEY;
+	setDeviceButton(port, trigger, !offscreen && (bits & (1U << RETRO_DEVICE_ID_JOYPAD_B)));
+	setDeviceButton(port, buttonKey, mapped);
+	if (!aw)
+		setDeviceButton(port, reloadKey, offscreen);
+	else if (offscreen)
+	{
+		mo_x_abs[port] = mo_y_abs[port] = -1;
+		setDeviceButton(port, AWAVE_TRIGGER_KEY, true);
+	}
+	// Existing Naomi/Maple hardware applies its per-game offscreen conversion;
+	// preserve the overlay position. AW reload is the native pump bit.
+	for (unsigned id : {RETRO_DEVICE_ID_JOYPAD_SELECT, RETRO_DEVICE_ID_JOYPAD_START,
+		RETRO_DEVICE_ID_JOYPAD_UP, RETRO_DEVICE_ID_JOYPAD_DOWN,
+		RETRO_DEVICE_ID_JOYPAD_LEFT, RETRO_DEVICE_ID_JOYPAD_RIGHT,
+		RETRO_DEVICE_ID_JOYPAD_L, RETRO_DEVICE_ID_JOYPAD_R,
+		RETRO_DEVICE_ID_JOYPAD_L2, RETRO_DEVICE_ID_JOYPAD_R2})
+		setDeviceButtonStateFromBitmap(bits, port, RETRO_DEVICE_JOYPAD, id);
+	// Test/Service are explicit Controls actions; do not inherit the stock
+	// R3-to-Button9 shortcut controlled by the core's service-button option.
+	if (arcade)
+	{
+		setDeviceButton(port, aw ? AWAVE_TEST_KEY : NAOMI_TEST_KEY, bits & (1U << RETRO_DEVICE_ID_JOYPAD_L3));
+		setDeviceButton(port, aw ? AWAVE_SERVICE_KEY : NAOMI_SERVICE_KEY, bits & (1U << RETRO_DEVICE_ID_JOYPAD_R3));
+	}
+}
+
 static void UpdateInputState(u32 port)
 {
 	if (gl_ctx_resetting)
 		return;
 
+	if (device_type[port] == RETRO_DEVICE_HYBRID_LIGHTGUN)
+	{
+		UpdateHybridLightgun(port);
+		return;
+	}
 	if (settings.platform.isArcade())
 	{
 		UpdateInputStateNaomi(port);
