 	return retVal;
 }
 
+// Absolute IR input for the exact Namco rev. B set supplied by Ron.
+// Patches live only in the loaded ROM buffer; original ZIP files are untouched.
+bool GalagaIRUnlimitedLives = false;
+bool GalagaIRInvincible = false;
+bool GalagaIRDoubleFighter = false;
+static bool galagaIRReady = false;
+static bool galagaIREnabled[2] = { false, false };
+static bool galagaIRFire[2] = { false, false };
+static INT32 galagaIRY[2] = { 0, 0 };
+static INT32 galagaIRX[2] = { 0, 0 };
+static UINT8 galagaIRMoveOriginal[13];
+static const UINT8 galagaIRMovePatch[13] = {
+    0x21,0x62,0x93,0x7e,0xa7,0xc8, // native inactive-ship guard: return if X=0
+    0x3a,0x00,0x60,0x77,   // ld a,(6000) / ld (hl),a: real gameplay position
+    0xc3,0xde,0x1f         // jp 1fde: original double-fighter positioning
+};
+void GalagaIRSetInput(unsigned port, bool enabled, int x, int y, bool fire)
+{
+    if (port < 2) { galagaIREnabled[port] = enabled; galagaIRX[port] = x; galagaIRY[port] = y; galagaIRFire[port] = fire; }
+}
+bool ArcadeIREnabled(unsigned port) { return port<2 && galagaIREnabled[port]; }
+int ArcadeIRAxis(unsigned port,unsigned axis) { return port<2 ? (axis ? galagaIRY[port] : galagaIRX[port]) : 0; }
+bool ArcadeIRFire(unsigned port) { return port<2 && galagaIRFire[port]; }
+
+static void GalagaIRInit()
+{
+    galagaIRReady = false;
+    // Never apply these addresses to another revision or to Dig Dug/Xevious.
+    if (strcmp(BurnDrvGetTextA(DRV_NAME), "galaga") != 0) return;
+    static const UINT8 move[13] = {0xe6,0x0a,0xfe,0x0a,0x28,0x37,0x21,0x15,0x92,0xcb,0x46,0x28,0x02};
+    static const UINT8 dual[9] = {0xcb,0x43,0xc8,0xc6,0x0f,0x32,0x60,0x93,0xc9};
+    static const UINT8 lives[7] = {0x21,0x20,0x98,0x7e,0x35,0xa7,0xc2};
+    static const UINT8 hit[4] = {0x3a,0x14,0x90,0xa7};
+    if (memcmp(memory.Z80.rom1+0x1f9c,move,13) ||
+        memcmp(memory.Z80.rom1+0x1fde,dual,9) ||
+        memcmp(memory.Z80.rom1+0x04e2,lives,7) ||
+        memcmp(memory.Z80.rom2+0x05ee,hit,4)) {
+        bprintf(PRINT_ERROR, _T("[Galaga IR] ROM signature mismatch; custom patches disabled.\n"));
+        return;
+    }
+    memcpy(galagaIRMoveOriginal, memory.Z80.rom1+0x1f9c,13);
+    galagaIRReady = true;
+    bprintf(PRINT_NORMAL, _T("[Galaga IR] Namco rev. B signatures verified.\n"));
+}
+static UINT8 GalagaIRPosition()
+{
+    const unsigned player = memory.RAM.shared3[0x40] & 1; // active player ID at 9840
+    if (!galagaIRReady || !galagaIREnabled[player] || memory.RAM.shared2[0x201] != 3)
+        return memory.RAM.shared2[0x362];
+    const INT32 lo = 0x12;
+    const INT32 hi = memory.RAM.shared3[0x27] & 1 ? 0xd1 : 0xe1;
+    INT32 x = galagaIRX[player];
+    // Cocktail native movement reverses along with the display.
+    if (memory.RAM.shared2[0x215] & 1) x = -1-x;
+    return lo + ((x+32768)*(hi-lo)+32767)/65535;
+}
+static void GalagaIRApply()
+{
+    if (!galagaIRReady) return;
+    const bool playing = memory.RAM.shared2[0x201] == 3;
+    const unsigned player = memory.RAM.shared3[0x40] & 1;
+    // Grant a real native second fighter only while the main ship is playable.
+    // Wait for a destroyed secondary fighter to disappear; don't overwrite
+    // explosions, tractor-beam capture, or the rescued-ship landing sequence.
+    if (playing && GalagaIRDoubleFighter && memory.RAM.shared2[0x14] &&
+        !memory.RAM.shared2[0x1c] && !memory.RAM.shared2[0x1d] &&
+        !(memory.RAM.shared3[0x27] & 1) && memory.RAM.shared2[0x362] &&
+        !memory.RAM.shared2[0x360] && memory.RAM.shared1[0x362] == 6) {
+        if (memory.RAM.shared2[0x362] > 0xd1) memory.RAM.shared2[0x362] = 0xd1;
+        // The three sprite buffers are code/color, position, and control.
+        memory.RAM.shared1[0x360] = 6;
+        memory.RAM.shared1[0x361] = 9;
+        memory.RAM.shared2[0x360] = memory.RAM.shared2[0x362] + 15;
+        memory.RAM.shared2[0x361] = memory.RAM.shared2[0x363];
+        memory.RAM.shared3[0x360] = memory.RAM.shared3[0x362];
+        memory.RAM.shared3[0x361] = memory.RAM.shared3[0x363];
+        memory.RAM.shared1[0x60] = memory.RAM.shared1[0x62];
+        memory.RAM.shared3[0x27] = 1;
+    }
+    const bool aim = playing && galagaIREnabled[player];
+    // Upright Galaga shares one physical stick between turns. Route the active
+    // frontend player's trigger into both native cabinet input banks.
+    if (aim) {
+        for (INT32 p=1;p<=2;p++) {
+            input.ports[p].current.byte |= 0x10;
+            if (galagaIRFire[player]) input.ports[p].current.byte &= 0xef;
+        }
+    }
+    memcpy(memory.Z80.rom1+0x1f9c, aim ? galagaIRMovePatch : galagaIRMoveOriginal,13);
+    // Keep the game's death/respawn/capture logic; suppress only reserve decrement.
+    memory.Z80.rom1[0x04e6] = playing && GalagaIRUnlimitedLives ? 0x00 : 0x35;
+    if (playing && GalagaIRUnlimitedLives && memory.RAM.shared3[0x20] == 0)
+        memory.RAM.shared3[0x20] = 1;
+    // Collision task returns immediately; capture is a separate native task.
+    memory.Z80.rom2[0x05ee] = playing && GalagaIRInvincible ? 0xc9 : 0x3a;
+}
+
 static UINT8 __fastcall namcoZ80ProgRead(UINT16 addr)
 {
+    if (addr == 0x6000 && galagaIRReady) return GalagaIRPosition();
 	struct CPU_Rd_Table *rdEntry = machine.config->rdAddrList;
 	UINT8 dta = 0;
 
@@ -1234,6 +1333,7 @@ static void namcoRenderSprites(void)
 
 static INT32 DrvExit(void)
 {
+	galagaIRReady = false;
 	GenericTilesExit();
 
 	NamcoSoundExit();
@@ -1316,6 +1416,7 @@ static INT32 DrvFrame(void)
 	}
 
 	DrvMakeInputs();
+	GalagaIRApply();
 
 	INT32 nInterleave = 400;
 	INT32 nCyclesTotal[3];
@@ -2105,7 +2206,9 @@ static INT32 galagaInit(void)
 
 	machine.config = &galagaMachineConfig;
 
-	return namcoInitBoard();
+	INT32 result = namcoInitBoard();
+	if (!result) GalagaIRInit();
+	return result;
 }
 
