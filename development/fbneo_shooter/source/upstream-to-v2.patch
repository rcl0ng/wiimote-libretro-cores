+static UINT8 GalaxianIRPosition()
+{
+ unsigned p=GalZ80Ram1[0x0d]&1;
+ int x=ArcadeIRAxis(p,0);
+ if (GalZ80Ram1[0x18]&1) x=-1-x;
+ return 0xe9-((x+32768)*(0xe9-0x16)+32767)/65535;
+}
+static void GalaxianIRApply()
+{
