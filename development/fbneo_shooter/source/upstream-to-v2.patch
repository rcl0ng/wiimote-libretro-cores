+ bool aim=playing && ArcadeIREnabled(p);
+ memcpy(GalZ80Rom1+0x847,aim ? patch : galaxianIRMove,30);
+ if (aim) {
+  GalInput[0]&=~0x10; GalInput[1]&=~0x10;
+  if (ArcadeIRFire(p)) { GalInput[0]|=0x10;GalInput[1]|=0x10; }
+ }
+ GalZ80Rom1[0x1314]=playing && GalagaIRUnlimitedLives ? 0 : 0x35;
+ if (playing && GalagaIRUnlimitedLives && GalZ80Ram1[0x21d]==0) GalZ80Ram1[0x21d]=1;
+ GalZ80Rom1[0x12f2]=playing && GalagaIRInvincible ? 0xc9 : 0xc8;
+}
