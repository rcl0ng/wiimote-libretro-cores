+/* Absolute IR coordinates use the native Saturn gun's nominal units.
+ * Endpoints are valid onscreen positions, not an offscreen sentinel.
+ * No accumulator, smoothing or touchscreen release latch is involved. */
+static void input_update_ir_gun(retro_input_state_t cb, unsigned port,
+                                INPUT_DATA *out, bool bitmasks)
+{
+    uint16_t buttons = 0;
+    bool reload, trigger, start;
+    int x, y;
+    if (bitmasks)
+        buttons = (uint16_t)cb(port, RETRO_DEVICE_JOYPAD, 0,
+                              RETRO_DEVICE_ID_JOYPAD_MASK);
+    reload = bitmasks ? !!(buttons & (1u << RETRO_DEVICE_ID_JOYPAD_A)) :
+             !!cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A);
+    trigger = bitmasks ? !!(buttons & (1u << RETRO_DEVICE_ID_JOYPAD_B)) :
+              !!cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B);
+    start = bitmasks ? !!(buttons & (1u << RETRO_DEVICE_ID_JOYPAD_START)) :
+            !!cb(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START);
+    out->u8[4] = start ? 0x2 : 0;
+    if (reload || geometry_height == 0)
+    {
+        x = y = -16384;
+        if (reload) out->u8[4] |= 0x4;
+    }
+    else
+    {
+        int raw_x = cb(port, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT,
+                       RETRO_DEVICE_ID_ANALOG_X);
+        int raw_y = cb(port, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_LEFT,
+                       RETRO_DEVICE_ID_ANALOG_Y);
+        x = (int)(((int64_t)raw_x + 32768) * 21471 / 65535);
+        y = (int)(((int64_t)raw_y + 32768) * (geometry_height - 1) / 65535)
+            + (int)geometry_height - 240;
+        if (trigger) out->u8[4] |= 0x1;
+    }
+    out->gun_pos[0] = (uint16_t)x;
+    out->gun_pos[1] = (uint16_t)y;
+}
