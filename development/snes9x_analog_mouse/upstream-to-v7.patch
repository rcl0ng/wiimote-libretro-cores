+/* Mario Paint (Japan/USA, CRC from Ron's tested ROM) uses these WRAM
+ * coordinates and exclusive upper bounds. Observe them; never write game RAM.
+ * Send correction at the game's mouse poll, after its previous movement was applied.
+ */
+static bool mario_paint_fly_screen()
+{
+    // CODE_01A0xx sets these display shadows on Fly Swatter entry;
+    // CODE_01A238 restores 06/66/13 when returning to the editor.
+    return Memory.RAM[0x10e] == 0x66 && Memory.RAM[0x10f] == 0x66 &&
+        Memory.RAM[0x11a] == 0x17;
+}
+static int mario_paint_word(unsigned offset)
+{
+    return int(int16_t(unsigned(Memory.RAM[offset]) |
+        (unsigned(Memory.RAM[offset + 1]) << 8)));
+}
+bool snes9x_analog_mouse_reference_packet(int port, unsigned &dx, unsigned &dy)
+{
+    static unsigned long long status_frame = ~0ULL;
+    if (setting_mouse_diagnostics && log_cb && port == 0 &&
+        (analog_mouse_frame % 60 == 0) && status_frame != analog_mouse_frame)
+    {
+        status_frame = analog_mouse_frame;
+        log_cb(RETRO_LOG_INFO,
+            "AM_PROFILE frame=%llu enabled=%d analog=%d initialized=%d crc=%08x expected=38c9626c cursor=%d,%d bounds=%d,%d,%d,%d\n",
+            analog_mouse_frame, int(setting_mouse_mario_paint), int(setting_mouse_left_analog),
+            int(analog_mouse_trackers[0].initialized), unsigned(Memory.ROMCRC32),
+            mario_paint_word(0x4dc), mario_paint_word(0x4de),
+            mario_paint_word(0x4d4), mario_paint_word(0x4d6),
+            mario_paint_word(0x4d8), mario_paint_word(0x4da));
+    }
+    if (!setting_mouse_mario_paint || !setting_mouse_left_analog || port != 0 ||
+        Memory.ROMCRC32 != 0x38c9626c || !analog_mouse_trackers[0].initialized)
+        return false;
+    int min_x = mario_paint_word(0x4d4), max_x = mario_paint_word(0x4d6);
+    int min_y = mario_paint_word(0x4d8), max_y = mario_paint_word(0x4da);
+    int cur_x = mario_paint_word(0x4dc), cur_y = mario_paint_word(0x4de);
+    // Fly Swatter's CODE_01A54F uses immediate bounds. Editor boundary
+    // words can be zero OR remain populated from the painting screen.
+    // Detect the screen instead of interpreting stale editor limits.
+    if (mario_paint_fly_screen())
+    {
+        min_x = 0x18; max_x = 0xe8;
+        min_y = 0x20; max_y = 0xd0;
+    }
+    if (min_x < -256 || max_x > 512 || min_y < -256 || max_y > 512 ||
+        max_x <= min_x || max_y <= min_y ||
+        cur_x < -256 || cur_x > 512 || cur_y < -256 || cur_y > 512)
+        return false; // Uninitialized or different game state: use general input.
+    int target_x = analog_mouse_trackers[0].last_x;
+    int target_y = analog_mouse_trackers[0].last_y;
+    if (target_x < min_x) target_x = min_x;
+    if (target_x >= max_x) target_x = max_x - 1;
+    if (target_y < min_y) target_y = min_y;
+    if (target_y >= max_y) target_y = max_y - 1;
+    int move_x = analog_mouse_clutch[0] ? 0 : target_x - cur_x;
+    int move_y = analog_mouse_clutch[0] ? 0 : target_y - cur_y;
+    if (move_x < -127) move_x = -127;
+    if (move_x > 127) move_x = 127;
+    if (move_y < -127) move_y = -127;
+    if (move_y > 127) move_y = 127;
+    dx = move_x < 0 ? (128 | -move_x) : move_x;
+    dy = move_y < 0 ? (128 | -move_y) : move_y;
+    if (setting_mouse_diagnostics && log_cb)
+        log_cb(RETRO_LOG_INFO,
+            "AM_REFERENCE frame=%llu cursor=%d,%d target=%d,%d packet=%d,%d bounds=%d,%d,%d,%d select=%d fly=%d\n",
+            analog_mouse_frame, cur_x, cur_y, target_x, target_y, move_x, move_y,
+            min_x, max_x, min_y, max_y, int(analog_mouse_clutch[0]), int(mario_paint_fly_screen()));
+    return true;
+}
+void snes9x_analog_mouse_log_packet(int port, int cur_x, int cur_y,
+        int old_x, int old_y, unsigned dx, unsigned dy, unsigned buttons)
+{
+    if (setting_mouse_diagnostics && setting_mouse_left_analog && log_cb)
