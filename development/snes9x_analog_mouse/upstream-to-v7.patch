+            "AM_PACKET frame=%llu port=%d cur=%d,%d consumed=%d,%d packet=%d,%d buttons=0x%02x\n",
+            analog_mouse_frame, port + 1, cur_x, cur_y, old_x, old_y,
+            (dx & 128) ? -int(dx & 127) : int(dx),
+            (dy & 128) ? -int(dy & 127) : int(dy), buttons);
+}
