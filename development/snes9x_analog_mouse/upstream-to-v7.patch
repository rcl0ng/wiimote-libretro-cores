+#!/usr/bin/env python3
+from pathlib import Path
+import os,shlex,subprocess,tempfile
+os.chdir(Path(__file__).resolve().parent.parent/'libretro')
+subprocess.run(['make','-j4','LTO='],check=True)
+lines=subprocess.check_output(['make','-B','-n','LTO='],text=True).splitlines()
+compile_line=next(l for l in lines if ' -c ' in l and '../libretro/libretro.cpp' in l)
+link=shlex.split(next(l for l in reversed(lines) if ' -o snes9x_libretro.so ' in l))
+with tempfile.TemporaryDirectory() as d:
+    obj=str(Path(d)/'test.o');exe=str(Path(d)/'test')
+    args=[a for a in shlex.split(compile_line) if a!='-DNDEBUG']
+    args[args.index('-o../libretro/libretro.o')]='-o'+obj
+    args[args.index('../libretro/libretro.cpp')]='../tests/analog_mouse_test.cpp'
+    subprocess.run(args,check=True)
+    objects=[a for a in link if a.endswith('.o') and a!='../libretro/libretro.o']
+    subprocess.run(['g++','-o',exe,obj,*objects,'-lm'],check=True)
+    subprocess.run([exe],check=True)
