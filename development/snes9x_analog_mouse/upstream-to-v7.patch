diff --git a/tests/analog_mouse_test.cpp b/tests/analog_mouse_test.cpp
new file mode 100644
index 0000000..295f71a
--- /dev/null
+++ b/tests/analog_mouse_test.cpp
@@ -0,0 +1,181 @@
+#include "../libretro/libretro.cpp"
+#undef NDEBUG
+#include <assert.h>
+#include <stdarg.h>
+#include <string>
+static std::string captured_log;
+static void capture_log(enum retro_log_level, const char *fmt, ...)
+{
+    char line[1024]; va_list args; va_start(args,fmt);
+    vsnprintf(line,sizeof(line),fmt,args); va_end(args); captured_log += line;
+}
+static int16_t axes[2][2];
+static unsigned buttons[2];
+static int16_t fake_input(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+    assert(port < 2);
+    if (device == RETRO_DEVICE_ANALOG)
+    {
+        assert(index == RETRO_DEVICE_INDEX_ANALOG_LEFT && id < 2);
+        return axes[port][id];
+    }
+    if (device == RETRO_DEVICE_JOYPAD)
+        return !!(buttons[port] & (1u << id));
+    if (device == RETRO_DEVICE_MOUSE)
+    {
+        if (id == RETRO_DEVICE_ID_MOUSE_X) return 12;
+        if (id == RETRO_DEVICE_ID_MOUSE_Y) return -8;
+        if (id == RETRO_DEVICE_ID_MOUSE_LEFT) return 1;
+    }
+    return 0;
+}
+static uint32_t packet(int port, bool latch = true)
+{
+    uint32_t result = 0;
+    if (latch)
+    {
+        S9xSetJoypadLatch(true);
+        S9xSetJoypadLatch(false);
+    }
+    for (int n=0; n<32; n++) result = (result << 1) | (S9xReadJOYSERn(port) & 1);
+    return result;
+}
+static int dx(uint32_t p) { unsigned b=p&255; return b&128 ? -int(b&127) : int(b); }
+static int dy(uint32_t p) { unsigned b=(p>>8)&255; return b&128 ? -int(b&127) : int(b); }
+static void ram_word(unsigned offset, int value)
+{ Memory.RAM[offset]=value&255; Memory.RAM[offset+1]=(value>>8)&255; }
+static void fixture(bool analog)
+{
+    setting_mouse_select_clutch=true;
+    setting_mouse_mario_paint=false; memset(analog_mouse_clutch,0,sizeof(analog_mouse_clutch));
+    memset(axes,0,sizeof(axes)); memset(buttons,0,sizeof(buttons));
+    memset(analog_mouse_trackers,0,sizeof(analog_mouse_trackers));
+    memset(snes_mouse_state,0,sizeof(snes_mouse_state));
+    S9xUnmapAllControls(); map_buttons();
+    Settings.MouseMaster = TRUE;
+    S9xSetController(0,CTL_MOUSE,0,0,0,0);
+    S9xSetController(1,CTL_MOUSE,1,0,0,0);
+    S9xControlsSoftReset();
+    snes_devices[0]=snes_devices[1]=RETRO_DEVICE_MOUSE;
+    setting_mouse_left_analog=analog;
+    g_screen_gun_width=256; g_screen_gun_height=224;
+    input_state_cb=fake_input;
+}
+int main()
+{
+    fixture(true);
+    report_buttons();
+    assert(dx(packet(0))==0 && dy(packet(1, false))==0); // First sample causes no jump.
+    axes[0][0]=32767; axes[0][1]=-32768;
+    axes[1][0]=-32768;
+    report_buttons();
+    uint32_t p=packet(0), q=packet(1, false);
+    assert(dx(p)==127 && dy(p)==-111);
+    assert(dx(q)==-127 && dy(q)==0); // Independent second mouse.
+    p=packet(0); assert(dx(p)==1 && dy(p)==0); // Remaining one unit delivered.
+    for(int n=0;n<120;n++)
+    {
+        report_buttons(); p=packet(0); q=packet(1, false);
+        assert(dx(p)==0 && dy(p)==0 && dx(q)==0 && dy(q)==0);
+    }
+    buttons[0]=1u<<RETRO_DEVICE_ID_JOYPAD_SELECT;
+    axes[0][0]=-32768; axes[0][1]=32767;
+    report_buttons(); p=packet(0); assert(dx(p)==0 && dy(p)==0); // Clutch.
+    buttons[0]=0; report_buttons(); p=packet(0);
+    assert(dx(p)==0 && dy(p)==0); // Release has no jump.
+    buttons[0]=(1u<<RETRO_DEVICE_ID_JOYPAD_B)|(1u<<RETRO_DEVICE_ID_JOYPAD_A);
+    report_buttons(); p=packet(0); assert(((p>>16)&0xc0)==0xc0);
+    buttons[0]=0; report_buttons(); p=packet(0); assert(((p>>16)&0xc0)==0);
+    fixture(false); report_buttons(); p=packet(0);
+    assert(dx(p)==12 && dy(p)==-8 && ((p>>16)&0xc0)==0x40);
+    fixture(true);
+    setting_mouse_diagnostics = true; log_cb = capture_log;
+    report_buttons(); packet(0); packet(1, false); captured_log.clear();
+    axes[0][0]=32767; axes[0][1]=-32768;
+    report_buttons(); p=packet(0); packet(1, false);
+    assert(dx(p)==127 && dy(p)==-111);
+    assert(captured_log.find("raw=32767,-32768")!=std::string::npos);
+    assert(captured_log.find("delta=128,-111")!=std::string::npos);
+    assert(captured_log.find("packet=127,-111")!=std::string::npos);
+    captured_log.clear(); buttons[0]=1u<<RETRO_DEVICE_ID_JOYPAD_SELECT;
+    report_buttons(); packet(0);
+    assert(captured_log.find("select=1")!=std::string::npos);
+    setting_mouse_diagnostics=false; captured_log.clear();
+    report_buttons(); packet(0); assert(captured_log.empty()); log_cb=NULL;
+    fixture(true); Memory.ROMCRC32=0x38c9626c;
+    memset(Memory.RAM,0,sizeof(Memory.RAM));
+    ram_word(0x4d4,-16); ram_word(0x4d6,272);
+    ram_word(0x4d8,8); ram_word(0x4da,216);
+    ram_word(0x4dc,180); ram_word(0x4de,170);
+    report_buttons(); packet(0); // Establish relative origin.
+    axes[0][1]=32767; report_buttons(); p=packet(0);
+    assert(dy(p)==112 && 170+dy(p)>=216); // Game rejects this overshoot.
+    report_buttons(); p=packet(0); assert(dy(p)==0); // Lost movement is not retried.
+    setting_mouse_mario_paint=true;
+    report_buttons(); p=packet(0);
+    assert(dx(p)==-53 && dy(p)==45); // Correct actual game cursor to 127,215.
+    ram_word(0x4dc,180+dx(p)); ram_word(0x4de,170+dy(p));
+    for(int n=0;n<120;n++)
+    { report_buttons(); p=packet(0); assert(dx(p)==0 && dy(p)==0); }
+    // Game moves/recenters cursor while Wiimote remains at the same target.
+    ram_word(0x4dc,20); axes[0][0]=32767;
+    report_buttons(); p=packet(0); assert(dx(p)==127 && dy(p)==0);
+    ram_word(0x4dc,20+dx(p)); report_buttons(); p=packet(0); assert(dx(p)==108);
+    ram_word(0x4dc,147+dx(p)); report_buttons(); p=packet(0); assert(dx(p)==0);
+    // New tighter game bounds: clamp to the last accepted coordinate.
+    ram_word(0x4d6,200); ram_word(0x4dc,190);
+    report_buttons(); p=packet(0); assert(dx(p)==9);
+    buttons[0]=1u<<RETRO_DEVICE_ID_JOYPAD_SELECT;
+    report_buttons(); p=packet(0); assert(dx(p)==0 && dy(p)==0);
+    // Fly Swatter leaves editor bounds zero and rejects moves outside
+    // [24,232) x [32,208). Holding left must recover a stranded x=37.
+    buttons[0]=0;
+    ram_word(0x4d4,0); ram_word(0x4d6,0);
+    ram_word(0x4d8,0); ram_word(0x4da,0);
+    Memory.RAM[0x10e]=0x66; Memory.RAM[0x10f]=0x66; Memory.RAM[0x11a]=0x17;
+    ram_word(0x4dc,37); ram_word(0x4de,73);
+    axes[0][0]=-32767; axes[0][1]=0;
+    report_buttons(); p=packet(0); assert(dx(p)==-13 && dy(p)==38);
+    ram_word(0x4dc,24); ram_word(0x4de,111);
+    for(int n=0;n<120;n++)
+    { report_buttons(); p=packet(0); assert(dx(p)==0 && dy(p)==0); }
+    axes[0][0]=32767; axes[0][1]=32767;
+    for(int n=0;n<4;n++)
+    {
+        report_buttons(); p=packet(0);
+        int x=mario_paint_word(0x4dc)+dx(p),y=mario_paint_word(0x4de)+dy(p);
+        assert(x>=24 && x<232 && y>=32 && y<208);
+        ram_word(0x4dc,x); ram_word(0x4de,y);
+    }
+    assert(mario_paint_word(0x4dc)==231 && mario_paint_word(0x4de)==207);
+    // Re-entering Fly Swatter after painting leaves editor limits populated.
+    ram_word(0x4d4,-16); ram_word(0x4d6,272);
+    ram_word(0x4d8,8); ram_word(0x4da,216);
+    ram_word(0x4dc,195); ram_word(0x4de,89);
+    axes[0][1]=-6388;
+    report_buttons(); p=packet(0); assert(dx(p)==36 && dy(p)==0);
+    ram_word(0x4dc,231); report_buttons(); p=packet(0); assert(dx(p)==0);
+    // Returning to the editor restores its limits even at the same aim.
+    Memory.RAM[0x10e]=0x06; Memory.RAM[0x11a]=0x13;
+    report_buttons(); p=packet(0); assert(dx(p)==24);
+    Memory.RAM[0x10e]=0x66; Memory.RAM[0x11a]=0x17;
+    // Disabled clutch ignores Select in reference and general mouse modes.
+    setting_mouse_select_clutch=false;
+    buttons[0]=1u<<RETRO_DEVICE_ID_JOYPAD_SELECT;
+    ram_word(0x4dc,200); report_buttons(); p=packet(0);
+    assert(dx(p)==31 && !analog_mouse_clutch[0]);
+    setting_mouse_mario_paint=false;
+    axes[0][0]=0; report_buttons(); p=packet(0);
+    assert(dx(p)==-127 && !analog_mouse_clutch[0]);
+    setting_mouse_mario_paint=true;
+    Memory.RAM[0x10e]=0x06; Memory.RAM[0x11a]=0x13;
+    // Other ROMs and invalid/uninitialized boundaries cannot invoke the profile.
+    unsigned ux=0,uy=0;
+    Memory.ROMCRC32=0; assert(!snes9x_analog_mouse_reference_packet(0,ux,uy));
+    Memory.ROMCRC32=0x38c9626c; ram_word(0x4d4,-16); ram_word(0x4d6,-16);
+    assert(!snes9x_analog_mouse_reference_packet(0,ux,uy));
+    assert(!snes9x_analog_mouse_reference_packet(1,ux,uy));
+    puts("PASS: Mario Paint rejected-overshoot regression, actual cursor recovery, stationary target, game recentering, exclusive bounds, clutch, ROM/port guards");
+    puts("PASS: diagnostic values, Select detection, logging disabled; real SNES mouse packets, first sample, 127-unit limit, bounded backlog, stationary aim, independent ports, clutch, clicks, native mouse");
+    return 0;
+}
