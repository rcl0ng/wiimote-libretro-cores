--- /dev/null
+++ b/libretro/analog_mouse.h
@@ -0,0 +1,38 @@
+#ifndef SNES9X_ANALOG_MOUSE_H
+#define SNES9X_ANALOG_MOUSE_H
+
+#include <stdint.h>
+
+bool snes9x_analog_mouse_reference_packet(int port, unsigned &dx, unsigned &dy);
+
+void snes9x_analog_mouse_log_packet(int port, int cur_x, int cur_y,
+        int old_x, int old_y, unsigned dx, unsigned dy, unsigned buttons);
+
+struct AnalogMouseTracker
+{
+    int last_x, last_y;
+    bool initialized;
+};
+
+/* Convert a change in absolute stick position into mouse movement.
+ * First sample and clutch samples establish an origin without moving.
+ * Never integrate stick deflection as velocity.
+ */
+static inline void analog_mouse_delta(AnalogMouseTracker &tracker,
+        int16_t x, int16_t y, int width, int height, bool clutch,
+        int &dx, int &dy)
+{
+    int px = ((int(x) + 32768) * (width - 1)) / 65535;
+    int py = ((int(y) + 32768) * (height - 1)) / 65535;
+    dx = dy = 0;
+    if (tracker.initialized && !clutch)
+    {
+        dx = px - tracker.last_x;
+        dy = py - tracker.last_y;
+    }
+    tracker.last_x = px;
+    tracker.last_y = py;
+    tracker.initialized = true;
+}
+
+#endif
