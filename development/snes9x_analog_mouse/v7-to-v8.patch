+++ b/libretro/analog_mouse_profiles.h
@@ -0,0 +1,86 @@
+#ifndef SNES9X_ANALOG_MOUSE_PROFILES_H
+#define SNES9X_ANALOG_MOUSE_PROFILES_H
+
+// Read-only game observations. Bounds are inclusive, in the game's coordinates.
+// Match exact ROM CRCs: an unverified revision must never use guessed RAM addresses.
+struct AnalogMouseReference
+{
+    const char *name;
+    int x, y, min_x, max_x, min_y, max_y;
+    int hotspot_x, hotspot_y;
+    int packet_limit;
+    bool paddle;
+};
+
+static inline int am_word(const unsigned char *ram, unsigned a)
+{
+    return int(short(unsigned(ram[a]) | (unsigned(ram[a + 1]) << 8)));
+}
+
+static inline bool analog_mouse_game_reference(const unsigned char *ram,
+        unsigned crc, int port, AnalogMouseReference &r)
+{
+    r = { "", 0, 0, 0, 255, 0, 223, 0, 0, 127, false };
+    switch (crc)
+    {
+    case 0xb50503a0: // Arkanoid: Doh It Again (USA), first player's paddle.
+        if (port != 0 || ram[0x442] != 0xff || ram[0x46e] != 1 ||
+            ram[0x472] != 1 || ram[0x447] < 8 || ram[0x447] > 64)
+            return false;
+        r.name = "arkanoid";
+        r.x = ram[0x44f]; r.y = 0;
+        r.min_x = 16; r.max_x = 175 - ram[0x447];
+        r.hotspot_x = ram[0x447] / 2;
+        r.paddle = true;
+        // The game caps its signed movement at +/-8. Larger packets do not
+        // move faster, and very large positive values can wrap its arithmetic.
+        r.packet_limit = 8;
+        break;
+    case 0xdf7200c8: // Lemmings 2 (USA): screen cursor, not world coordinates.
+        if (port != 0) return false;
+        r.name = "lemmings2";
+        r.x = ram[0xc34]; r.y = ram[0xc35];
+        r.min_x = ram[0x1025]; r.max_x = ram[0x1027];
+        r.min_y = ram[0x1026]; r.max_y = ram[0x1028];
+        break;
+    case 0xc8e80d55: // Super Solitaire (USA, multilingual).
+        if (port != 0) return false;
+        r.name = "super_solitaire";
+        r.x = ram[0x388]; r.y = ram[0x389];
+        break;
+    case 0x03a0e935: // Vegas Stakes (USA): active mouse port is a game setting.
+        if (am_word(ram, 0x11cb) == 0 || port != (am_word(ram, 0x114d) ? 1 : 0))
+            return false;
+        r.name = "vegas_stakes";
+        r.x = am_word(ram, 0x1147); r.y = am_word(ram, 0x1149);
+        r.max_x = 256; r.max_y = 240;
+        break;
+    case 0x8af25e7e: // Might and Magic III (USA): mouse index 0/1, FF absent.
+        if (ram[0x1c79] > 1 || port != ram[0x1c79]) return false;
+        r.name = "might_and_magic3";
+        r.x = ram[0x1c7a]; r.y = ram[0x1c7b];
+        r.min_x = 6; r.max_x = 244; r.max_y = 214;
+        break;
+    default:
+        return false;
+    }
+    return r.min_x < r.max_x && r.min_y < r.max_y &&
+        r.x >= r.min_x && r.x <= r.max_x &&
+        (r.paddle || (r.y >= r.min_y && r.y <= r.max_y));
+}
+
+static inline int analog_mouse_clamp(int v, int lo, int hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+static inline void analog_mouse_reference_delta(const AnalogMouseReference &r,
+        int aim_x, int aim_y, bool clutch, int &target_x, int &target_y,
+        int &move_x, int &move_y)
+{
+    target_x = analog_mouse_clamp(aim_x - r.hotspot_x, r.min_x, r.max_x);
+    target_y = r.paddle ? r.y : analog_mouse_clamp(aim_y - r.hotspot_y, r.min_y, r.max_y);
+    move_x = clutch ? 0 : analog_mouse_clamp(target_x - r.x, -r.packet_limit, r.packet_limit);
+    move_y = clutch || r.paddle ? 0 : analog_mouse_clamp(target_y - r.y, -r.packet_limit, r.packet_limit);
+}
+#endif
