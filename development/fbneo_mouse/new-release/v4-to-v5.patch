+// Neo Pong's original paddle limits correspond to Y=20..206.
+bool BurnIRPaddleTarget(INT32 port, INT32 *target)
+{
+    if (port<0 || port>=MAX_PLAYERS || nDeviceType[port]!=RETRO_IR_MOUSE) return false;
+    int raw=input_cb_wrapper(port,RETRO_DEVICE_ANALOG,RETRO_DEVICE_INDEX_ANALOG_LEFT,RETRO_DEVICE_ID_ANALOG_Y);
+    *target=20+((raw+32768)*187)/65536;
+    return true;
+}
+
+void BurnIRPaddleReport(INT32 port, INT32 target, INT32 actual)
+{
+    retro_variable v={"fbneo-ir-mouse-diagnostics",NULL};
+    bool diagnostics=environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE,&v)&&v.value&&!strcmp(v.value,"enabled");
+    if(!diagnostics) { if(irDiagnosticFile){filestream_close(irDiagnosticFile);irDiagnosticFile=NULL;} return; }
+    if(!irDiagnosticFile) {
+        char path[MAX_PATH];snprintf(path,sizeof(path),"%s%cfbneo-ir-mouse.log",g_save_dir,PATH_DEFAULT_SLASH_C());
+        irDiagnosticFile=filestream_open(path,RETRO_VFS_FILE_ACCESS_WRITE,RETRO_VFS_FILE_ACCESS_HINT_NONE);
+        if(irDiagnosticFile) filestream_printf(irDiagnosticFile,"FBNeo IR Mouse v5 game=neopong\n");
+    }
+    if(port==0 && nDeviceType[0]!=RETRO_IR_MOUSE) irDiagnosticFrame++;
+    if (irDiagnosticFile && irDiagnosticFrame%10==1) {
+        filestream_printf(irDiagnosticFile,"PADDLE frame=%d player=%d target_y=%d actual_y=%d\n",irDiagnosticFrame,port+1,target,actual);
+        filestream_flush(irDiagnosticFile);
+    }
+}
