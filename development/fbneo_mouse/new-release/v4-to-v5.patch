+#ifdef __LIBRETRO__
+// Version-specific RAM-only program patch for Neo Pong v1.1. The ZIP is never
+// written. Only manual player branches are redirected; AI, ball and collision
+// code remain native. Each player independently returns to the original code
+// when its frontend device changes away from IR Mouse.
+static UINT16 irPongWord(UINT32 a) { return Neo68KROMActive[a]|(Neo68KROMActive[a+1]<<8); }
+static void irPongWrite(UINT32 a,UINT16 w) { Neo68KROMActive[a]=w&255;Neo68KROMActive[a+1]=w>>8; }
+static void irPongPatch()
+{
+    if (strcmp(BurnDrvGetTextA(DRV_NAME),"neopong") || !Neo68KROMActive) return;
+    const UINT32 branch[2]={0x3140,0x3386}, stub[2]={0x1e000,0x1e040};
+    const UINT32 next[2]={0x3230,0x3482};
+    // Validate both native movement write sites before touching the program.
+    if (irPongWord(0x319e)!=0x33c1 || irPongWord(0x33e4)!=0x33c1) return;
+    for (int p=0;p<2;p++) {
+        UINT32 a=branch[p],t=stub[p];
+        bool original=irPongWord(a)==0x0800 && irPongWord(a+2)==0 && irPongWord(a+4)==0x6700;
+        bool patched=irPongWord(a)==0x4ef9 && irPongWord(a+2)==(t>>16) && irPongWord(a+4)==(t&65535);
+        if (!original && !patched) continue;
+        INT32 y=0;
+        if (!BurnIRPaddleTarget(p,&y)) {
+            if(patched) { irPongWrite(a,0x0800);irPongWrite(a+2,0);irPongWrite(a+4,0x6700); }
+            if(NeoGraphicsRAM) BurnIRPaddleReport(p,-1,(512-(*((UINT16*)(NeoGraphicsRAM+(0x82f0+p*0x10)*2))>>7))&511);
+            continue;
+        }
+        int actual=NeoGraphicsRAM ? (512-(*((UINT16*)(NeoGraphicsRAM+(0x82f0+p*0x10)*2))>>7))&511 : y;
+        // The movement branch is patched, but the native ball deflection code
+        // still reads controller directions. Feed the real direction of travel.
+        UINT8 *joy=p?NeoJoy2:NeoJoy1;
+        joy[0]=y<actual; joy[1]=y>actual;
+        UINT16 words[]={0x13fc,0x0000,0x0010,(UINT16)(0x007b+p),
+            0x3e3c,(UINT16)(0x82f0+p*0x10),0x33c7,0x003c,0x0000,
+            0x323c,(UINT16)(((512-y)<<7)|2),0x33c1,0x003c,0x0002,
+            0x4ef9,(UINT16)(next[p]>>16),(UINT16)next[p]};
+        words[1]=y<actual?2:y>actual?1:(patched?irPongWord(t+2):0);
+        for(unsigned k=0;k<sizeof(words)/sizeof(words[0]);k++) irPongWrite(t+k*2,words[k]);
+        irPongWrite(a,0x4ef9);irPongWrite(a+2,t>>16);irPongWrite(a+4,t&65535);
+        if (NeoGraphicsRAM) BurnIRPaddleReport(p,y,(512-(*((UINT16*)(NeoGraphicsRAM+(0x82f0+p*0x10)*2))>>7))&511);
+    }
+}
+#endif
