diff --git a/libretro/rc-absolute-gun.h b/libretro/rc-absolute-gun.h
new file mode 100644
index 0000000..ab78ba6
--- /dev/null
+++ b/libretro/rc-absolute-gun.h
@@ -0,0 +1,62 @@
+/* Shared absolute-gun helpers. GPL-2.0-or-later. */
+#ifndef RC_ABSOLUTE_GUN_H
+#define RC_ABSOLUTE_GUN_H
+#include <stdint.h>
+#include <string.h>
+/* Conservative basename recognition: punctuation/region suffixes are ignored,
+ * but complete normalized names are compared (no substring matching). */
+static inline void rc_content_name(const char *path, char *out, unsigned cap)
+{
+    const char *b = path ? path : "", *p; unsigned n = 0;
+    for (p=b; *p; ++p) if (*p=='/' || *p=='\\') b=p+1;
+    for (p=b; *p && *p!='.' && *p!='(' && *p!='['; ++p) {
+        unsigned char c=(unsigned char)*p;
+        if (c>='A' && c<='Z') c=(unsigned char)(c+32);
+        if ((c>='a' && c<='z') || (c>='0' && c<='9')) {
+            if (n+1>=cap) { out[0]=0; return; }
+            out[n++]=(char)c;
+        }
+    }
+    out[n]=0;
+}
+static inline int rc_match_list(const char *name, const char *const *list, unsigned count)
+{ unsigned i; for(i=0;i<count;++i) if(!strcmp(name,list[i])) return 1; return 0; }
+static inline int rc_c64_gun(const char *path)
+{
+    char n[128];
+    static const char *const mag[]={"armydays","babyblues","blazeout","cosmicstorm","duckhunt","gangster","ghosttown","goosebusters","gunslinger","operationthunderbolt","operationwolf","timetraveller","shootinputin"};
+    static const char *const stack[]={"cosmiccommando","grouseshoot","glorioustwelth","glorioustwelfth","glorious12th","highnoonshootout","indianattack","shootinggallery","starbasedefence64","starbasedefence"};
+    rc_content_name(path,n,sizeof(n));
+    if(rc_match_list(n,mag,sizeof(mag)/sizeof(*mag))) return 14;
+    if(rc_match_list(n,stack,sizeof(stack)/sizeof(*stack))) return 15;
+    return 0;
+}
+static inline int rc_3do_guns(const char *path)
+{
+    char n[128];
+    static const char *const two[]={"crimepatrol","drugwars","lastbountyhunterthe","thelastbountyhunter","lastbountyhunter","maddogiithelostgold","maddog2thelostgold","maddogmccree","spacepirates","whoshotjohnnyrock"};
+    rc_content_name(path,n,sizeof(n));
+    if(!strcmp(n,"corpsekiller")) return 1;
+    return rc_match_list(n,two,sizeof(two)/sizeof(*two)) ? 2 : 0;
+}
+/* 1=HOTD3, 2=Silent Scope, 3=Starsky/Hutch. */
+static inline int rc_xbox_profile(const char *path)
+{
+    char n[128]; rc_content_name(path,n,sizeof(n));
+    if(!strcmp(n,"houseofthedeadiiithe") || !strcmp(n,"thehouseofthedeadiii") || !strcmp(n,"houseofthedeadiii") || !strcmp(n,"houseofthedead3")) return 1;
+    if(!strcmp(n,"silentscopecomplete")) return 2;
+    if(!strcmp(n,"starskyhutch") || !strcmp(n,"starskyandhutch")) return 3;
+    return 0;
+}
+static inline int rc_axis_pixel(int16_t axis, int size, int offset)
+{ return size>0 ? offset+(int)(((int64_t)axis+32768)*(size-1)/65535) : offset; }
+static inline int16_t rc_invert_axis(int16_t axis)
+{ return axis == -32768 ? 32767 : (int16_t)-axis; }
+static inline int16_t rc_calibrated_axis(int16_t axis,float scale,int offset)
+{
+    float v=(float)axis*scale+(float)offset;
+    if(v<-32768.0f) return -32768;
+    if(v>32767.0f) return 32767;
+    return (int16_t)v;
+}
+#endif
