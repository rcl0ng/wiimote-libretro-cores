+      if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE,&v) && v.value)
+         cur_port=atoi(v.value)==1 ? 1 : 2;
+      if(opt_joyport_type>10) cur_port=1;
+   }
+}
